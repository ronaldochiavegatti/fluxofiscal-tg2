{
  "components": {
    "schemas": {
      "Body_upload_document_upload_post": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "file": {
            "format": "binary",
            "title": "File",
            "type": "string"
          },
          "user_cnpj": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Cnpj"
          }
        },
        "required": [
          "file",
          "email"
        ],
        "title": "Body_upload_document_upload_post",
        "type": "object"
      },
      "ConfirmDocument": {
        "properties": {
          "amount": {
            "exclusiveMinimum": 0.0,
            "maximum": 99999999.99,
            "title": "Amount",
            "type": "number"
          },
          "cnpj_destinatario": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cnpj Destinatario"
          },
          "cnpj_emitente": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cnpj Emitente"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "documento_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Documento Id"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "ocr_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ocr Text"
          },
          "source_filename": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Filename"
          },
          "tx_date": {
            "format": "date",
            "title": "Tx Date",
            "type": "string"
          },
          "tx_type": {
            "title": "Tx Type",
            "type": "string"
          }
        },
        "required": [
          "email",
          "amount",
          "tx_date",
          "tx_type"
        ],
        "title": "ConfirmDocument",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Documents Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/arquivos/{chave}": {
      "get": {
        "description": "Serve o arquivo do disco — só faz sentido no modo local (flag desligada).\nNo modo MinIO a URL de `/url` já aponta direto para o objeto.",
        "operationId": "baixar_arquivo_local_arquivos__chave__get",
        "parameters": [
          {
            "in": "path",
            "name": "chave",
            "required": true,
            "schema": {
              "title": "Chave",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {}
            },
            "description": "O arquivo"
          },
          "404": {
            "description": "Arquivo não encontrado"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Baixar Arquivo Local"
      }
    },
    "/auditoria": {
      "get": {
        "operationId": "listar_auditoria_auditoria_get",
        "parameters": [
          {
            "in": "query",
            "name": "email",
            "required": true,
            "schema": {
              "format": "email",
              "title": "Email",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Trilha de auditoria indisponível"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Listar Auditoria"
      }
    },
    "/auditoria/integridade": {
      "get": {
        "description": "Recalcula a cadeia de hash. `integra: false` significa que algum\nregistro foi alterado ou removido fora do fluxo de escrita.",
        "operationId": "integridade_da_trilha_auditoria_integridade_get",
        "parameters": [
          {
            "in": "query",
            "name": "documento_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Documento Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Trilha de auditoria indisponível"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Integridade Da Trilha"
      }
    },
    "/confirm": {
      "post": {
        "description": "Confirma (com possíveis correções manuais) os dados extraídos, incluindo o\ntipo de operação (venda ou compra) escolhido/confirmado pelo usuário, e só\nentão registra a transação no serviço de Limits. Também indexa o texto do\ndocumento no RAG do Agent Orchestrator, para consultas futuras do agente.",
        "operationId": "confirm_document_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmDocument"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "tx_type fora de 'venda' | 'compra'"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "description": "O serviço de limites recusou o registro"
          }
        },
        "summary": "Confirm Document"
      }
    },
    "/documentos": {
      "get": {
        "description": "Histórico de documentos do usuário (US-20). Sobrevive à troca de\ndispositivo porque vive no MongoDB, não no navegador.",
        "operationId": "listar_documentos_documentos_get",
        "parameters": [
          {
            "in": "query",
            "name": "email",
            "required": true,
            "schema": {
              "format": "email",
              "title": "Email",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Persistência de documentos desligada"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Listar Documentos"
      }
    },
    "/documentos/{documento_id}": {
      "get": {
        "operationId": "obter_documento_documentos__documento_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "documento_id",
            "required": true,
            "schema": {
              "title": "Documento Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Documento não encontrado"
          },
          "409": {
            "description": "Persistência de documentos desligada"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Obter Documento"
      }
    },
    "/documentos/{documento_id}/auditoria": {
      "get": {
        "description": "\"De onde veio este número\": a trilha de um documento, do valor extraído\naté a correção humana.",
        "operationId": "auditoria_do_documento_documentos__documento_id__auditoria_get",
        "parameters": [
          {
            "in": "path",
            "name": "documento_id",
            "required": true,
            "schema": {
              "title": "Documento Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Trilha de auditoria indisponível"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Auditoria Do Documento"
      }
    },
    "/documentos/{documento_id}/reprocessar": {
      "post": {
        "description": "Recoloca na fila um documento que ficou em `erro` (US-18, \"tentar de novo\").",
        "operationId": "reprocessar_documento_documentos__documento_id__reprocessar_post",
        "parameters": [
          {
            "in": "path",
            "name": "documento_id",
            "required": true,
            "schema": {
              "title": "Documento Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Documento não encontrado"
          },
          "409": {
            "description": "Persistência de documentos desligada, ou documento fora de 'erro'"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Reprocessar Documento"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/reset": {
      "delete": {
        "description": "Apaga todos os arquivos salvos em /data/uploads. O Documents Service\nnão mantém banco de dados próprio (o registro fica no Limits), então\nresetar aqui significa só limpar os arquivos físicos enviados durante\nos testes.",
        "operationId": "reset_uploads_reset_delete",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Reset Uploads"
      }
    },
    "/upload": {
      "post": {
        "operationId": "upload_document_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_document_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "202": {
            "description": "Aceito para processamento assíncrono (flag ocr-assincrono)"
          },
          "400": {
            "description": "Arquivo sem nome"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upload Document"
      }
    },
    "/url": {
      "get": {
        "description": "URL temporária para baixar um documento já enviado (US-19).\n\nCom `storage-minio` ligada, devolve uma URL pré-assinada de 15 minutos, e o\narquivo não trafega por este serviço — o cliente baixa direto do MinIO.",
        "operationId": "url_do_arquivo_url_get",
        "parameters": [
          {
            "in": "query",
            "name": "chave",
            "required": true,
            "schema": {
              "title": "Chave",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "email",
            "required": true,
            "schema": {
              "format": "email",
              "title": "Email",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "description": "A chave não pertence a este e-mail"
          },
          "404": {
            "description": "Arquivo não encontrado"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Url Do Arquivo"
      }
    }
  }
}
