            "description": "Relatório anual"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Report Pdf"
      }
    },
    "/reset/{email}": {
      "delete": {
        "description": "Apaga TODAS as transações (vendas e compras) do usuário, usado pelo\nbotão de reset da demo para permitir testes limpos e repetíveis.",
        "operationId": "reset_user_data_reset__email__delete",
        "parameters": [
          {
            "in": "path",
            "name": "email",
            "required": true,
            "schema": {
              "format": "email",
              "title": "Email",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Reset User Data"
      }
    },
    "/ritmo/{email}": {
      "get": {
        "description": "Gauge e painel de ritmo do dashboard (US-25), sobre o motor de\ndomínio da US-28. Agrega só o necessário para `calcular_projecao`; quem\ndecide o nível e a tendência é o domínio, não esta rota.",
        "operationId": "get_ritmo_ritmo__email__get",
        "parameters": [
          {
            "in": "path",
            "name": "email",
            "required": true,
            "schema": {
              "format": "email",
              "title": "Email",
              "type": "string"
            }
          },
          {
            "description": "Ano de referência; padrão é o ano corrente",
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 2100,
                  "minimum": 2000,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Ano de referência; padrão é o ano corrente",
              "title": "Year"
            }
          },
          {
            "description": "Abertura do MEI. Sem valor, assume abertura antes do ano de referência (limite cheio) — o cadastro real chega com a US-34 (Perfil do MEI).",
            "in": "query",
            "name": "data_abertura",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Abertura do MEI. Sem valor, assume abertura antes do ano de referência (limite cheio) — o cadastro real chega com a US-34 (Perfil do MEI).",
              "title": "Data Abertura"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RitmoOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "data_abertura não pode ser depois de hoje (ou do fim do ano fechado)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Ritmo"
      }
    },
    "/ritmo/{email}/serie": {
      "get": {
        "description": "Curva do acumulado real do ano, um ponto por dia — a área \"realizado\"\ndo gráfico de corrida contra o limite (US-26). A linha de referência e o\ncone de projeção são calculados no cliente, a partir de `GET /ritmo`: são\nsó reta e taxas, não precisam de outra viagem ao banco.\n\nCarrega o último valor conhecido adiante nos dias sem venda, para a área\nficar contínua em vez de cair a zero entre lançamentos.",
        "operationId": "get_serie_acumulada_ritmo__email__serie_get",
        "parameters": [
          {
            "in": "path",
            "name": "email",
            "required": true,
            "schema": {
              "format": "email",
              "title": "Email",
              "type": "string"
            }
          },
          {
            "description": "Ano de referência; padrão é o ano corrente",
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 2100,
                  "minimum": 2000,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Ano de referência; padrão é o ano corrente",
              "title": "Year"
            }
          }
        ],
