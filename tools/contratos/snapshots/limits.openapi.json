  "info": {
    "title": "Limits Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/concentracao/{email}": {
      "get": {
        "description": "\"Origem do faturamento\" do dashboard (US-27): concentração de venda\npor CNPJ do cliente. Só entra venda com `cnpj_cliente` identificado — o\npercentual é sobre esse total identificado, não sobre o faturamento do\nano inteiro (ver docstring de `calcular_concentracao_clientes`).",
        "operationId": "get_concentracao_concentracao__email__get",
        "parameters": [
          {
            "in": "path",
            "name": "email",
            "required": true,
            "schema": {
              "format": "email",
              "title": "Email",
              "type": "string"
            }
          },
          {
            "description": "Ano de referência; padrão é o ano corrente",
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 2100,
                  "minimum": 2000,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Ano de referência; padrão é o ano corrente",
              "title": "Year"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConcentracaoClienteOut"
                  },
                  "title": "Response Get Concentracao Concentracao  Email  Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Concentracao"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/mensal/{email}": {
      "get": {
        "description": "\"Mês a mês\" do dashboard (US-27): vendas e despesas por mês, com a\nmeta mensal sobreposta. Doze pontos sempre, mês sem lançamento incluso\ncom zero — quem decide isso é `dominio.faturamento.calcular_serie_mensal`.",
        "operationId": "get_mensal_mensal__email__get",
        "parameters": [
          {
            "in": "path",
            "name": "email",
            "required": true,
            "schema": {
              "format": "email",
              "title": "Email",
              "type": "string"
            }
          },
          {
            "description": "Ano de referência; padrão é o ano corrente",
            "in": "query",
            "name": "year",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 2100,
                  "minimum": 2000,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Ano de referência; padrão é o ano corrente",
              "title": "Year"
            }
          },
          {
            "description": "Abertura do MEI, para a meta considerar o limite proporcional — mesmo default seguro de /ritmo (limite cheio) sem a US-34.",
            "in": "query",
            "name": "data_abertura",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Abertura do MEI, para a meta considerar o limite proporcional — mesmo default seguro de /ritmo (limite cheio) sem a US-34.",
              "title": "Data Abertura"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MesResumoOut"
                  },
                  "title": "Response Get Mensal Mensal  Email  Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "data_abertura não pode ser depois do ano de referência"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Mensal"
      }
    },
    "/report/{email}": {
      "get": {
        "description": "Gera um relatório em PDF com o resumo anual e as transações do MEI.",
        "operationId": "get_report_pdf_report__email__get",
        "parameters": [
          {
            "in": "path",
            "name": "email",
            "required": true,
            "schema": {
              "format": "email",
              "title": "Email",
              "type": "string"
