                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Ano de referência; padrão é o ano corrente",
              "title": "Year"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/pdf": {}
