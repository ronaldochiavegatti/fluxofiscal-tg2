%%{init: {"themeVariables": {"fontSize": "22px"}, "flowchart": {"nodeSpacing": 30, "rankSpacing": 45, "padding": 8}}}%%
%% Figura 1 do artigo — componentes da arquitetura implementada.
%% Conferido contra o código em 19/11/2026: app/services/api-gateway/nginx.conf,
%% chamadas HTTP entre serviços (*_BASE_URL), docker-compose.yml e
%% docs/feature-flags.yaml; registro de consumo conferido contra consumo.py
%% (ADR-0024). Linha tracejada = caminho desligado por padrão (flag).
flowchart TB
    U([Usuário MEI<br/>navegador])
    FE["<b>Frontend</b><br/>React + Vite + Tailwind"]
    GW["<b>API Gateway (NGINX)</b><br/>roteamento e correlation-id<br/><i>infraestrutura</i>"]
    UN["<b>Unleash</b><br/>feature flags"]
    PR["<b>Prometheus</b><br/>coleta /metrics"]

    U -->|HTTPS| FE
    FE -->|REST / JSON| GW
    GW -->|/unleash-frontend| UN

    subgraph MS["Microsserviços de backend (8)"]
        AU["<b>Autenticação</b><br/>cadastro e login<br/><i>não usado pelo frontend</i><br/>[auth_db]"]
        BI["<b>Cobrança</b><br/>saldo de créditos e<br/>extrato de consumo<br/>[billing_db]"]
        AG["<b>Orquestrador do Agente</b><br/>chat e RAG<br/>[agent_db + pgvector]"]
        DO["<b>Documentos</b><br/>OCR Tesseract + extração<br/>(sem PostgreSQL)"]
        LI["<b>Limites</b><br/>regra fiscal do MEI<br/>[limits_db]"]
        IN["<b>Insights</b><br/>modelo de leitura<br/>[insights_db]"]
        NO["<b>Notificações</b><br/>esqueleto<br/>[notifications_db]"]
        WK["<b>Worker (Celery)</b><br/>leitura assíncrona"]
    end

    GW -->|/auth| AU
    GW -->|/billing| BI
    GW -->|/agent| AG
    GW -->|/documents| DO
    GW -->|/limits| LI
    GW -->|/insights| IN
    GW -->|/notifications| NO

    DO -->|POST /transactions| LI
    DO -->|POST /index-document| AG
    AG -->|GET /summary/email| LI
    IN -->|GET /transactions e /summary| LI
    DO -.->|consumo| BI
    AG -.->|consumo| BI

    GE["<b>«externo» Gemini API</b><br/>extração, embeddings e respostas"]
    DO -->|extração| GE
    AG -->|embeddings + resposta| GE

    subgraph ST["Armazenamento e fila (ligados por flag)"]
        MI[("<b>MinIO</b><br/>arquivos<br/><i>flag storage-minio</i>")]
        MO[("<b>MongoDB</b><br/>histórico e auditoria<br/><i>flag documentos-persistidos</i>")]
        RE[("<b>Redis</b><br/>fila e eventos")]
    end

    DO -.-> MI
    DO -.-> MO
    DO -.->|tarefa · ocr-assincrono| RE
    RE -.-> WK
    WK -.->|POST /_interno/processar| DO
    LI -.->|eventos · eventos-outbox| RE
    RE -.->|eventos| IN

