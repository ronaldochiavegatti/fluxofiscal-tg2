{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git add:*)",
      "Bash(git rebase origin/main)",
      "Bash(git worktree:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(mypy:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(mutmut:*)",
      "Bash(npm ci)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(python tools/flags/auditar.py:*)"
    ],
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push * main)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Read(./app/.env)",
      "Read(./.env)",
      "Write(./app/.env)",
      "Edit(./app/.env)"
    ],
    "ask": [
      "Edit(./app/docker-compose.yml)",
      "Edit(./app/docker-compose.release.yml)",
      "Edit(./app/docker-compose.observability.yml)",
      "Edit(./docs/feature-flags.yaml)",
      "Edit(./ruff.toml)",
      "Edit(./app/requirements-dev.txt)",
      "Edit(./.github/workflows/ci.yml)",
      "Edit(./.github/workflows/cd.yml)",
      "Edit(./.github/workflows/dora.yml)",
      "Edit(./.github/workflows/benchmarks.yml)",
      "Edit(./.github/workflows/higiene-flags.yml)",
      "Edit(./docs/observabilidade/slos.yaml)",
      "Edit(./app/services/frontend/tailwind.config.js)",
      "Edit(./app/services/frontend/src/pages/DashboardPage.tsx)"
    ]
  }
}
