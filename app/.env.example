# =====================================================================
# FluxoFiscal - variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env real.
#   cp .env.example .env
# =====================================================================

# ---------- IA generativa (Google Gemini) ----------
# Sem a chave, os serviços entram em modo demo (sem chamar a API).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---------- Object storage (MinIO / S3) ----------
MINIO_ROOT_USER=fiscalflow
MINIO_ROOT_PASSWORD=troque-esta-senha
MINIO_BUCKET=fiscalflow-documents
MINIO_ENDPOINT=http://minio:9000
# Chave de KMS para SSE-S3, no formato <nome>:<32 bytes em base64>.
# Gere a sua: echo "fiscalflow:$(openssl rand -base64 32)"
# Vazia, o compose usa uma chave de desenvolvimento pública (só para a pilha local).
MINIO_KMS_SECRET_KEY=

# ---------- Fila assíncrona (Redis / Celery) ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# US-18: a tarefa do worker chama a rota interna do documents. Vazio = rota
# aberta (padrão de dev, ADR-0011); em produção, um segredo compartilhado.
DOCUMENTS_BASE_URL=http://documents:8000
INTERNO_TOKEN=
# US-21: barramento de eventos (Outbox + Redis Streams). Vazio = a flag
# `eventos-outbox` no Unleash decide; "true" liga sem Unleash (usado na CI).
EVENTOS_STREAM=fluxofiscal:eventos
EVENTOS_GRUPO=insights
# ADR-0019: o notifications consome `alerta.disparado` no seu próprio grupo,
# independente do insights.
EVENTOS_GRUPO_NOTIFICATIONS=notifications
FORCAR_EVENTOS_OUTBOX=

# ---------- Bancos próprios dos modelos de leitura ----------
# Vazio = usa o default do Compose (o Postgres do serviço na rede interna).
NOTIFICATIONS_DATABASE_URL=

# ---------- MongoDB (metadados de documentos e auditoria) ----------
MONGO_ROOT_USER=fiscalflow
MONGO_ROOT_PASSWORD=troque-esta-senha
MONGO_URL=mongodb://fiscalflow:troque-esta-senha@mongo:27017
MONGO_DB=fiscalflow

# ---------- Feature flags (Unleash, US-15 / ADR-0008) ----------
# Sem UNLEASH_URL o cliente nem tenta conectar: toda flag cai no padrão
# declarado no código (sempre o comportamento antigo e conhecido).
UNLEASH_URL=http://unleash:4242/api
UNLEASH_APP_NAME=fluxofiscal
UNLEASH_ENVIRONMENT=development
# Tokens de DESENVOLVIMENTO, seedados no próprio Compose via
# INIT_CLIENT_API_TOKENS / INIT_FRONTEND_API_TOKENS — não são segredo de
# produção, só a chave que liga o SDK ao Unleash local. Troque para gerar um
# ambiente isolado.
UNLEASH_API_TOKEN=default:development.unleash-insecure-dev-secret
UNLEASH_FRONTEND_TOKEN=default:development.unleash-insecure-dev-frontend-secret

# ---------- Observabilidade (OpenTelemetry) ----------
# O rastreamento distribuído só liga com OTEL_TRACES_ENABLED=true, o que é feito
# pelo overlay docker-compose.observability.yml. No Compose padrão fica inerte.
OTEL_TRACES_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000
