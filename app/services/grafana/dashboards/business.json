          "expr": "sum(rate(extracao_confianca_sum[5m])) by (metodo) / sum(rate(extracao_confianca_count[5m])) by (metodo)",
          "legendFormat": "{{metodo}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
