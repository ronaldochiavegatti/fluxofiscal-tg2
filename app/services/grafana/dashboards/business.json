  "panels": [
    {
      "title": "Documentos processados por método",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(documentos_processados_total[5m])) by (metodo)",
          "legendFormat": "{{metodo}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "fillOpacity": 60 }
        }
      }
    },
    {
      "title": "Razão de contingência (regex vs total)",
      "description": "Porcentagem de documentos que caíram para extração baseada em regex",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(documentos_processados_total{metodo=\"regex\"}[5m])) / sum(rate(documentos_processados_total[5m])) * 100",
          "legendFormat": "% contingência"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Consumo de tokens LLM por operação",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(llm_tokens_total[5m])) by (operacao, direcao)",
          "legendFormat": "{{operacao}} ({{direcao}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Custo acumulado do LLM (BRL)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(llm_custo_estimado_reais_total)",
          "legendFormat": "R$"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
          "decimals": 4
        }
      }
    },
    {
      "title": "Confiança média da extração",
